# ---------------------------------------------------------------------
# Warehouse Control Tower - environment settings
# Copy this file to ".env" and fill in your own values.
#   Windows PowerShell:  Copy-Item .env.example .env
# ---------------------------------------------------------------------

# PostgreSQL credentials
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=almoxarifado_db

# Host and port (usually keep the defaults)
DB_HOST=localhost
DB_PORT=5432

# Application port.
# NOTE: use 8090 (or any free port) if 8080 is occupied by another
# service on the machine, such as a SCADA/HMI runtime.
SERVER_PORT=8090

# --- Optional telemetry tuning -------------------------------------------
# Base delay between simulation cycles, in milliseconds
SIMULATION_INTERVAL_MS=5000
# Start with the simulator paused? (true / false)
SIMULATION_ACTIVE=true
# Event multiplier: 0.1 = quiet, 1.0 = normal, 3.0 = peak
SIMULATION_INTENSITY=1.0

# --- Optional supply-chain tuning ---------------------------------------
# Window used for the inventory turnover calculation, in days
TURNOVER_WINDOW_DAYS=30
# Service target for closing a work order, in hours
SLA_TARGET_HOURS=48