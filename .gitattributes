# Normalise line endings so the repository behaves the same on Windows,
# Linux and macOS. Files are stored with LF and checked out per platform.
* text=auto eol=lf

# Explicit binary files
*.jar binary
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Shell scripts must keep LF: a CRLF shebang breaks on Linux/macOS.
mvnw text eol=lf

# Windows-only script stays CRLF.
mvnw.cmd text eol=crlf

# SQL, Java, JS, CSS, HTML and YAML are text with LF endings.
*.java   text eol=lf
*.sql    text eol=lf
*.js     text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.yml    text eol=lf
*.md     text eol=lf